---
interface Props {
  imageSrc: string;
  imageAlt?: string;
  title: string;
  text?: string;
  linkHref?: string;
  linkText?: string;
  reversed?: boolean;
}

const {
  imageSrc,
  imageAlt = "",
  title,
  text,
  linkHref,
  linkText,
  reversed = false,
} = Astro.props as Props;

const sectionClasses = [
  "section",
  "section-image-content",
  "section-border-bottom",
  "py-16",
  "bg-osp-soft",
  "text-osp",
].join(" ");

// dirección del flex en desktop
const layoutDirection = reversed ? "lg:flex-row-reverse" : "lg:flex-row";

// clases de columna izquierda (texto + botón)
const leftColClasses = [
  "w-full lg:w-1/2 flex flex-col justify-center items-center section-osp-propuesta-left",
  reversed ? "section-osp-propuesta-right-anim" : "section-osp-propuesta-left-anim",
].join(" ");

// clases de columna derecha (imagen)
const rightColClasses = [
  "w-full lg:w-1/2 flex justify-center p-4",
  reversed ? "lg:justify-start section-osp-propuesta-left-anim" : "lg:justify-end section-osp-propuesta-right-anim",
].join(" ");

// título partido en dos para intercalar blanco + dorado
const [firstPart, ...rest] = title.split(" ");
const secondPart = rest.join(" ");
---

<section class={sectionClasses}>
  <div class="shell">
    <div class={`section-osp-propuesta-layout flex flex-col ${layoutDirection}`}>
      {/* TEXTO + BOTÓN */}
      <div class={leftColClasses}>
        <h3 class="section-osp-propuesta-title">
          <span class="section-osp-propuesta-word section-osp-propuesta-word--light">
            {firstPart}
          </span>

          {secondPart && (
            <span class="section-osp-propuesta-word section-osp-propuesta-word--accent">
              {" "}{secondPart}
            </span>
          )}
        </h3>

        {/* Si querés texto, descomentá
        {text && (
          <p class="section-osp-propuesta-text">
            {text}
          </p>
        )} */}

        {linkHref && linkText && (
          <div class="section-osp-propuesta-black-box">
            <a href={linkHref} class="btn-osp-primary">
              {linkText}
            </a>
          </div>
        )}
      </div>

      {/* IMAGEN */}
      <div class={rightColClasses}>
        <img
          src={imageSrc}
          alt={imageAlt}
          class="section-osp-propuesta-photo max-w-lg rounded-xl"
        />
      </div>
    </div>
  </div>
</section>
