---
import logo from "../../public/images/logo-osp.png";
---

<footer class="footer bg-osp-soft text-osp">
  <div class="shell">
    {/* CARD OSCURA */}
    <div class="footer__card">
      <div
        class="footer__inner flex items-center justify-between gap-8"
      >
        <nav class="footer__nav footer__nav--left">
          <ul class="menu flex gap-6">
            <li class="menu-item">
              <a href="/team" class="footer__link">
                Nuestro Equipo
              </a>
            </li>
            <li class="menu-item">
              <a href="/services" class="footer__link">
                Nuestros Servicios
              </a>
            </li>
          </ul>
        </nav>

        <a href="/" class="footer__logo flex items-center justify-center">
          <div class="footer__logo-pill">
            <img
              src={logo.src}
              alt="OSP Abogadas"
              loading="lazy"
              class="footer__logo-img"
            />
          </div>
        </a>

        <nav class="footer__nav footer__nav--right">
          <ul class="menu flex gap-6">
            <li class="menu-item">
              <a href="/about" class="footer__link">
                Nuestro Método
              </a>
            </li>
            <li class="menu-item">
              <a href="/contact" class="footer__link">
                Contacto
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer__bar text-osp-muted text-xs mt-5 text-center">
      <p>© OSP Abogados · Todos los derechos reservados</p>
    </div>
  </div>
</footer>
