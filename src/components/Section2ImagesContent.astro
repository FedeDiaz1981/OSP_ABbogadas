---
interface Props {
  imageSrc: string;
  imageSrc2?: string;
  imageAlt?: string;
  title: string;
  text: string;
  linkHref?: string;
  linkText?: string;
  reversed?: boolean;
}

const {
  imageSrc,
  imageSrc2,
  imageAlt = "",
  title,      // ya no se usa, pero lo dejo por si lo necesitás en otro lado
  text,       // idem
  linkHref,
  linkText,
  reversed = false,
} = Astro.props as Props;

const sectionClasses = [
  "section",
  "section-image-content",
  "section-border-bottom",
  "section-image-content--osp",
  "section-image-content--with-card",
  reversed ? "section-image-content--reversed" : "",
]
  .filter(Boolean)
  .join(" ");
---

<section class={sectionClasses}>
  <div class="shell">
    <div
      class="section__inner section-image-content__inner"
      data-aos="fade-up"
      style="padding-top: 0px;"
    >
      {/* FILA SUPERIOR: 2 FOTOS */}
      <div class="section-image-content__media section-image-content__media--osp">
        {imageSrc && (
          <div
            class="section__image section-image-content__image section-image-content__image--primary section-image-content__image--osp"
            data-aos="fade-right"
            style="padding-bottom: 0px;"
          >
            <div class="section-image-content__image-wrapper">
              <img
                src={imageSrc}
                alt={imageAlt}
                class="section-image-content__image-el"
              />
            </div>
          </div>
        )}

        {imageSrc2 && (
          <div
            class="section__image section-image-content__image section-image-content__image--secondary section-image-content__image--osp"
            data-aos="fade-left"
            style="padding-bottom: 0px;"
          >
            <div class="section-image-content__image-wrapper">
              <img
                src={imageSrc2}
                alt={imageAlt}
                class="section-image-content__image-el"
              />
            </div>
          </div>
        )}
      </div>

      {/* FILA INFERIOR: SOLO BOTÓN */}
      <div class="section__content section-image-content__content" style="padding-left: 0px;">
        <div class="section-image-content__card section-image-content__card--osp section-image-content__card--only-btn">
          {linkHref && linkText && (
            <a
              href={linkHref}
              class="btn btn-osp-primary section-image-content__link section-image-content__link--osp"
            >
              {linkText}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
