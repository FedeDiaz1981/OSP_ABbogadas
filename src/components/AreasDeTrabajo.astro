---
interface ServiceItem {
  title: string;
  description?: string;
}

interface Props {
  title?: string;
  services?: ServiceItem[];
}

const {
  title = "Nuestros servicios",
  services = [
    { title: "Asesoría legal" },
    { title: "Derecho laboral" },
    { title: "Contratos" },
    { title: "Registro de marca" },
    { title: "Estafas" },
    { title: "Sucesiones" },
    { title: "Alquileres" },
  ],
} = Astro.props as Props;

const words = title.toUpperCase().split(" ");
const midIndex = Math.ceil(words.length / 2);
const firstLine = words.slice(0, midIndex).join(" ");
const secondLine = words.slice(midIndex).join(" ");
---

<section class="section-areas bg-osp-soft text-osp">
  <div class="shell">
    <div class="osp-areas-card" data-aos="fade-up">
      {
        title && (
          <header class="osp-areas-head">
            <h3 class="osp-areas-title">
              <span class="osp-areas-title-line osp-areas-title-line--light hidden">
                {firstLine}
              </span>

              {secondLine && (
                <span class="osp-areas-title-line osp-areas-title-line--accent hidden">
                  {secondLine}
                </span>
              )}
            </h3>
            <span class="osp-areas-underline hidden" />
          </header>
        )
      }

      <div class="osp-areas-list">
        {
          services.map((item, index) => (
            <button
              type="button"
              class="osp-areas-pill"
              data-service-pill
              data-service-title={item.title}
              data-service-desc={
                item.description ??
                `Te asesoramos en todo lo relacionado con ${item.title.toLowerCase()}. Analizamos tu caso, explicamos tus opciones con lenguaje claro y definimos un plan de acción concreto para avanzar con seguridad.`
              }
            >
              <span class="osp-areas-pill-text">{item.title}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

   {/* MODAL DETALLE SERVICIO */}
  <div id="osp-service-modal" class="osp-modal" aria-hidden="true">
    <div class="osp-modal__backdrop"></div>

    <div class="osp-modal__dialog" role="dialog" aria-modal="true">
      <button type="button" class="osp-modal__close" aria-label="Cerrar">
        ×
      </button>

      <h4 class="osp-modal__title"></h4>
      <p class="osp-modal__text"></p>

      <div class="osp-modal__actions">
        <button
          type="button"
          class="btn btn-osp-primary osp-modal__cta mt-8 center-block"
        >
          Agendar consulta
        </button>
      </div>
    </div>
  </div>


    <script>
    if (typeof window !== "undefined") {
      window.addEventListener("DOMContentLoaded", () => {
        const modal = document.getElementById(
          "osp-service-modal"
        ) as HTMLElement | null;
        if (!modal) return;

        const titleEl = modal.querySelector(
          ".osp-modal__title"
        ) as HTMLElement | null;
        const textEl = modal.querySelector(
          ".osp-modal__text"
        ) as HTMLElement | null;
        const closeBtn = modal.querySelector(
          ".osp-modal__close"
        ) as HTMLButtonElement | null;
        const backdrop = modal.querySelector(
          ".osp-modal__backdrop"
        ) as HTMLElement | null;
        const ctaBtn = modal.querySelector(
          ".osp-modal__cta"
        ) as HTMLButtonElement | null;

        if (!titleEl || !textEl || !closeBtn || !backdrop) return;

        const openModal = (title: string, text: string) => {
          titleEl.textContent = title;
          textEl.textContent = text;
          modal.classList.add("is-open");
          document.body.style.overflow = "hidden";
        };

        const closeModal = () => {
          modal.classList.remove("is-open");
          document.body.style.overflow = "";
        };

        closeBtn.addEventListener("click", closeModal);
        backdrop.addEventListener("click", closeModal);

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeModal();
        });

        if (ctaBtn) {
          ctaBtn.addEventListener("click", () => {
            window.location.href = "/contact";
          });
        }

        document.querySelectorAll("[data-service-pill]").forEach((el) => {
          const btn = el as HTMLButtonElement;

          btn.addEventListener("click", () => {
            const title = btn.dataset.serviceTitle || "";
            const desc = btn.dataset.serviceDesc || "";
            openModal(title, desc);
          });
        });
      });
    }
  </script>

</section>
