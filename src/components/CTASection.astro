---
interface Props {
  title: string;
  buttonHref: string;
  buttonText: string;
}

const { title, buttonHref, buttonText } = Astro.props as Props;

const [firstWord, ...rest] = title.split(" ");
const remaining = rest.join(" ");
---

<section class="section-cta section-cta--osp">
  <div class="shell">
    <div class="section-cta__card">
      <div class="section-cta__inner">
        <h4 class="section-cta__title">
          <span class="section-cta__word section-cta__word--light">
            {firstWord}
          </span>
          {remaining && (
            <span class="section-cta__word section-cta__word--accent">
              {" "}{remaining}
            </span>
          )}
        </h4>

        <div class="section-cta__actions">
          <div class="section-cta__button-shell">
            <a href={buttonHref} class="btn-osp-primary section-cta__button">
              {buttonText}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
