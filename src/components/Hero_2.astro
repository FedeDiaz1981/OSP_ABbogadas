---
interface Props {
  Title?: string;
  Subtitle?: string;
}

const {
  Title = "",
  Subtitle = "",
} = Astro.props as Props;

import fondo from "../../public/images/hero_5.jpg";
---

<section class="mt-0">
  <div
    class="hero image-fit js-section-fullheight-wrapper hero--small-title-mobile relative max-h-[85vh]"
  >
    <!-- Fondo -->
    <img
      width="1920"
      height="1280"
      src={fondo.src}
      alt="Imagen principal del estudio"
      class="absolute inset-0 w-full h-full object-cover"
      decoding="async"
      fetchpriority="high"
      sizes="(max-width: 1920px) 100vw, 1920px"
    />

    <!-- Overlay (lo dejamos oscuro para mantener dramatismo visual) -->
    <div class="absolute inset-0 bg-black/55"></div>

    <div
      class="shell relative z-10 w-full flex items-center min-h-screen justify-center"
    >
      <div
        class="hero__inner js-section-fullheight min-h-screen flex items-center justify-center"
      >
        <div class="hero__content text-center">
          <div class="hero__subtitle">
            <h6 class="text-osp-accent">{Title}</h6>
          </div>

          <div class="hero__title js-title">
            <h1 class="h1 text-white drop-shadow-lg">{Subtitle}</h1>
          </div>
        </div>
      </div>
    </div>

    <a
      href="#inicio"
      class="btn-scroll-to-next-section js-btn-scroll-to hero-scroll-arrow absolute bottom-6 left-1/2 -translate-x-1/2"
      aria-label="Bajar a la siguiente sección"
    >
      <span aria-hidden="true"></span>
    </a>
  </div>
</section>
