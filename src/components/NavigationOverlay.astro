---
// src/components/NavigationOverlay.astro
---

<section
  class="section-navigation"
  data-nav
>
  {/* Overlay oscuro */}
  <div
    class="section__overlay"
    data-nav-overlay
  ></div>

  {/* Panel */}
  <div
    class="section__inner flex flex-col items-end px-7 pt-8 pb-10 text-white"
  >
    {/* Cerrar */}
    <button
      class="menu-close nav-close-btn"
      type="button"
      data-menu-close
      aria-label="Cerrar menú"
    >
      ✕
    </button>

    {/* Menú */}
    <nav class="nav w-full mt-8">
      <ul class="nav-menu">
        <li class="nav-menu__item">
          <a href="/services" class="nav-menu__link">
            Nuestros servicios
          </a>
        </li>
        <li class="nav-menu__item">
          <a href="/team" class="nav-menu__link">
            Nuestro equipo
          </a>
        </li>
        <li class="nav-menu__item">
          <a href="/about" class="nav-menu__link">
            Nuestro método
          </a>
        </li>
        <li class="nav-menu__item">
          <a href="/contact" class="nav-menu__link">
            Contacto
          </a>
        </li>
      </ul>
    </nav>

    {/* Botón reservar */}
    <div class="nav-cta mt-10 w-full flex justify-center">
      <a href="/book-consultation" class="btn-osp-primary nav-cta__button">
        Reservar consulta
      </a>
    </div>
  </div>
</section>

{/* FAB MENÚ SOLO MOBILE (fuera del section) */}
<button
  type="button"
  class="nav-fab md:hidden"
  data-nav-fab
  data-menu-toggle
  aria-label="Abrir menú"
>
  <span>Menú</span>
</button>
