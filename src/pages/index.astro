---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SectionImageContent from "../components/SectionImageContent.astro";
import Section2ImagesContent from "../components/Section2ImagesContent.astro";
import CTASection from "../components/CTASection.astro";

import abogada_1 from "../../public/images/Abogada_01_home.png";
import abogada_2 from "../../public/images/Abogada_02_home.png";

import servicio from "../../public/images/servicios.jpg";
import metodo from "../../public/images/metodo.jpg";

const whatsappHref =
  "https://wa.me/5491130191878?text=Hola!%20Quiero%20reservar%20una%20consulta";
---

<BaseLayout title="Inicio | OSP Abogados">
  <Hero />

  <SectionHeading
    subtitle="Bienvenido a"
    title="OSP Abogados"
  />

  <Section2ImagesContent
    imageSrc={abogada_1.src}
    imageSrc2={abogada_2.src}
    imageAlt="Equipo del estudio"
    title="Nuestro equipo"
    text=""
    linkHref="/team"
    linkText="Conocer al equipo"
  />

  <SectionImageContent
    imageSrc={servicio.src}
    imageAlt="Reunión con clientes"
    title="Nuestra propuesta"
    text=""
    linkHref="/services"
    linkText="Servicios"
    reversed={true}
  />

  <SectionImageContent
    imageSrc={metodo.src}
    imageAlt="Confianza y trayectoria"
    title="Cómo trabajamos contigo"
    text=""
    linkHref="/about"
    linkText="Nuestro método"
    reversed={false}
  />

  <CTASection
    title="¿Necesitás asesoramiento legal?"
    buttonHref={whatsappHref}
    buttonText="Reservar consulta"
  />

  <a
    href={whatsappHref}
    class="home-whatsapp-float"
    data-home-whatsapp-float
    aria-label="Abrir WhatsApp"
    title="Abrir WhatsApp"
    aria-hidden="true"
    tabindex="-1"
  >
    <svg
      viewBox="0 0 32 32"
      aria-hidden="true"
      focusable="false"
    >
      <path
        fill="currentColor"
        d="M19.11 17.2c-.27-.13-1.6-.79-1.85-.88-.25-.09-.43-.13-.61.14-.18.27-.7.88-.86 1.06-.16.18-.31.2-.58.07-.27-.13-1.13-.42-2.16-1.35-.8-.71-1.35-1.59-1.5-1.86-.16-.27-.02-.42.11-.56.12-.12.27-.31.41-.47.14-.16.18-.27.27-.45.09-.18.04-.34-.02-.47-.07-.13-.61-1.47-.84-2.02-.22-.53-.45-.46-.61-.47h-.52c-.18 0-.47.07-.72.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.13.18 1.91 2.92 4.62 4.09.65.28 1.15.45 1.55.57.65.21 1.25.18 1.72.11.52-.08 1.6-.65 1.83-1.28.22-.63.22-1.17.16-1.28-.07-.11-.25-.18-.52-.31Z"
      />
      <path
        fill="currentColor"
        d="M16.01 3.2c-6.97 0-12.63 5.67-12.63 12.63 0 2.22.58 4.39 1.68 6.3L3.2 28.8l6.84-1.79a12.58 12.58 0 0 0 5.96 1.51h.01c6.96 0 12.63-5.67 12.63-12.63S22.98 3.2 16.01 3.2Zm0 23.19h-.01a10.5 10.5 0 0 1-5.35-1.47l-.38-.22-4.06 1.06 1.08-3.96-.25-.41a10.48 10.48 0 0 1-1.61-5.5c0-5.82 4.74-10.56 10.57-10.56 2.82 0 5.47 1.1 7.46 3.1a10.49 10.49 0 0 1 3.09 7.46c0 5.83-4.74 10.57-10.54 10.57Z"
      />
    </svg>
  </a>

  <script>
    if (typeof window !== "undefined") {
      document.addEventListener("DOMContentLoaded", () => {
        const hero = document.querySelector(".hero-adjust");
        const button = document.querySelector("[data-home-whatsapp-float]");

        if (!hero || !button) return;

        document.body.appendChild(button);

        const updateButton = () => {
          const shouldShow = hero.getBoundingClientRect().bottom <= 0;

          button.classList.toggle("is-visible", shouldShow);
          button.setAttribute("aria-hidden", shouldShow ? "false" : "true");

          if (shouldShow) {
            button.removeAttribute("tabindex");
          } else {
            button.setAttribute("tabindex", "-1");
          }
        };

        updateButton();
        window.addEventListener("scroll", updateButton, { passive: true });
        window.addEventListener("resize", updateButton);
      });
    }
  </script>
</BaseLayout>
