---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Hero from "../components/Hero_2.astro";
import Abogada_1 from "../../public/images/Abogada_01.png";
import Abogada_2 from "../../public/images/Abogada_02.png";
---

<BaseLayout title="Equipo | OSP Abogadas">
  <Hero Title="nuestro" Subtitle="equipo" />

  <SectionHeading
    subtitle="Nuestro equipo"
    title="Abogadas"
  />

    <section class="section section-border-bottom pb-16 bg-osp-soft text-osp osp-team-section">
    <div class="shell">
      <header
        class="section__head text-center mb-10"
        data-aos="fade-up"
      >
        <h3 class="h3 text-osp-accent hidden">
          Nuestro equipo
        </h3>
      </header>

      <div
        class="section__inner team__grid grid gap-10 md:grid-cols-2 max-w-5xl mx-auto"
      >
        {/* DOMINIQUE */}
        <article
          class="osp-team-card"
          data-aos="fade-right"
        >
          {/* CONTENEDOR 1: FOTO + NOMBRE + ROL */}
          <div class="osp-team-panel osp-team-panel--top">
            <div class="osp-team-photo-wrapper">
              <img
                src={Abogada_1.src}
                alt="Dominique Olivier"
                class="osp-team-photo"
              />
            </div>

            <div class="osp-team-info">
              <h3 class="osp-team-name">
                Dominique Olivier
              </h3>
              <p class="osp-team-role">Abogada</p>
            </div>
          </div>

          {/* CONTENEDOR 2: ÁREAS + FRASE */}
          <div class="osp-team-panel osp-team-panel--bottom">
            <p class="osp-team-areas">
              Derecho del consumidor · Contratos · Sucesiones
            </p>
            <p class="osp-team-phrase">
              Siempre al lado del cliente para escuchar, estudiar y proponer la mejor estrategia.
            </p>
          </div>
        </article>

        {/* LUCILA */}
        <article
          class="osp-team-card"
          data-aos="fade-left"
        >
          {/* CONTENEDOR 1: FOTO + NOMBRE + ROL */}
          <div class="osp-team-panel osp-team-panel--top">
            <div class="osp-team-photo-wrapper">
              <img
                src={Abogada_2.src}
                alt="Lucila Stroppiana"
                class="osp-team-photo"
              />
            </div>

            <div class="osp-team-info">
              <h3 class="osp-team-name">
                Lucila Stroppiana
              </h3>
              <p class="osp-team-role">Abogada</p>
            </div>
          </div>

          {/* CONTENEDOR 2: ÁREAS + FRASE */}
          <div class="osp-team-panel osp-team-panel--bottom">
            <p class="osp-team-areas">
              Derecho civil · Derecho laboral · Amparos de salud
            </p>
            <p class="osp-team-phrase">
              Defiende tus derechos con firmeza y sensibilidad.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

</BaseLayout>
