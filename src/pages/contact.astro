---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Hero2 from "../components/Hero_2.astro";
---

<BaseLayout title="Reservar consulta | OSP Abogadas">
  <Hero2 Title="Agendar" Subtitle="contacto" />

  <SectionHeading
    subtitle="Consultas legales"
    title="sin demora"
  />

  <section class="section section-border-bottom section-consult bg-osp-soft text-osp">
  <div class="shell">
    <div
      class="consult-card"
      data-aos="fade-up"
    >
      <header class="consult-card__head">
        <p class="consult-card__eyebrow">
          Consultas legales
        </p>

        <h3 class="consult-card__title">
          SIN DEMORA
        </h3>

        <span class="consult-card__underline"></span>

        <p class="consult-card__text">
          ¿Tenés un problema legal y no sabés qué hacer? En OSP Abogados estamos para ayudarte.
        </p>
      </header>

      <form class="consultation__form space-y-4 text-left">
        <div class="grid gap-4 md:grid-cols-2">
          <input
            type="text"
            name="nombre"
            placeholder="Nombre completo"
            required
            class="consultation__field"
          />

          <input
            type="email"
            name="email"
            placeholder="Correo electrónico"
            required
            class="consultation__field"
          />

          <input
            type="tel"
            name="telefono"
            placeholder="Teléfono"
            required
            class="consultation__field"
          />

          <input
            type="date"
            name="fecha"
            required
            class="consultation__field consultation__field--date"
          />
        </div>

        <textarea
          name="detalle"
          placeholder="Contanos brevemente tu situación"
          required
          class="consultation__field consultation__field--textarea"
        ></textarea>

        <div class="mt-6 flex justify-center">
          <button
            type="submit"
            class="btn btn-osp-primary consultation__submit"
          >
            Solicitar turno
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

</BaseLayout>
