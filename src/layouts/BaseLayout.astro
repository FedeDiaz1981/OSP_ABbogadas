---
import NavigationOverlay from "../components/NavigationOverlay.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import logo from "../../public/images/logo-osp.png";
const { title = "Estudio Jurídico" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href={logo.src} />

    <!-- CSS del theme original -->
    <link rel="stylesheet" href="/css/theme_2.css" />

    <!-- Tema OSP (colores y helpers) -->
    <link rel="stylesheet" href="/css/osp-theme.css" />

    <!-- AOS -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
  </head>

  <body
    class="home wp-singular page-template page-template-templates page-template-page-builder page-template-templatespage-builder-php page page-id-6 wp-embed-responsive wp-theme-stanchieri-family-new is-loaded"
  >
    <div class="overlay" data-body-overlay></div>

    {/* HEADER FIJO, FUERA DEL WRAPPER */}
    <Header />
    <NavigationOverlay />
    <div class="wrapper bg-osp text-osp">
      <div class="wrapper__inner">
        <main class="main">
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" is:inline
    ></script>

    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js" is:inline></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.AOS) {
          window.AOS.init({
            duration: 600,
            once: true,
          });
        }
      });
    </script>

    <script type="module" src="/js/ui.js"></script>

    <script>
      if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
          const nav = document.querySelector("[data-nav]");
          if (!nav) return;

          const overlay = nav.querySelector("[data-nav-overlay]");
          const closeBtn = nav.querySelector("[data-menu-close]");
          const openers = document.querySelectorAll(
            "[data-menu-toggle], [data-nav-fab]"
          );

          const openNav = () => {
            nav.classList.add("is-open");
            document.body.style.overflow = "hidden";
          };

          const closeNav = () => {
            nav.classList.remove("is-open");
            document.body.style.overflow = "";
          };

          openers.forEach((btn) => {
            btn.addEventListener("click", openNav);
          });

          overlay && overlay.addEventListener("click", closeNav);
          closeBtn && closeBtn.addEventListener("click", closeNav);
        });
      }
    </script>
  </body>
</html>
